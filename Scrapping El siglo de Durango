        "!pip install beautifulsoup4 requests\n",
        "import csv\n",
        "import os\n",
        "import time\n",
        "import requests\n",
        "from bs4 import BeautifulSoup\n",
        "from google.colab import files  # Para descargar el archivo al finalizar\n",
        "\n",
        "# Configuración básica\n",
        "url_base = \"https://www.elsiglodedurango.com.mx/seccion/editorial/\"\n",
        "headers = {\n",
        "    \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"\n",
        "}\n",
        "\n",
        "def escrapear_notas_completas():\n",
        "    print(\"Paso 1: Recolectando enlaces de las editoriales...\")\n",
        "    try:\n",
        "        respuesta = requests.get(url_base, headers=headers, timeout=10)\n",
        "        if respuesta.status_code != 200:\n",
        "            print(f\"Error al acceder a la portada: {respuesta.status_code}\")\n",
        "            return\n",
        "\n",
        "        soup = BeautifulSoup(respuesta.text, 'html.parser')\n",
        "        articulos = soup.find_all('a', href=True)\n",
        "\n",
        "        enlaces_validos = set()\n",
        "        for art in articulos:\n",
        "            href = art['href']\n",
        "            texto = art.get_text(strip=True)\n",
        "            if \"/noticia/\" in href or \"editorial\" in href:\n",
        "                url_completa = href if href.startswith(\"http\") else f\"https://www.elsiglodedurango.com.mx{href}\"\n",
        "                # Filtro para evitar menús o enlaces vacíos\n",
        "                if url_completa not in enlaces_validos and len(texto) > 15:\n",
        "                    enlaces_validos.add(url_completa)\n",
        "\n",
        "        print(f\"Se encontraron {len(enlaces_validos)} enlaces válidos para analizar.\")\n",
        "\n",
        "        # Paso 2: Visitar cada enlace para extraer el contenido detallado\n",
        "        datos_finales = []\n",
        "        conteo = 0\n",
        "\n",
        "        print(\"\\nPaso 2: Extrayendo contenido detallado de cada nota (esto tomará un momento)...\")\n",
        "        for url_nota in enlaces_validos:\n",
        "            conteo += 1\n",
        "            print(f\"[{conteo}/{len(enlaces_validos)}] Procesando: {url_nota}\")\n",
        "\n",
        "            try:\n",
        "                # Petición a la nota individual\n",
        "                res_nota = requests.get(url_nota, headers=headers, timeout=10)\n",
        "                if res_nota.status_code == 200:\n",
        "                    soup_nota = BeautifulSoup(res_nota.text, 'html.parser')\n",
        "\n",
        "                    # 1. Extraer el Título\n",
        "                    # Usualmente está en una etiqueta <h1>\n",
        "                    titulo = soup_nota.find('h1')\n",
        "                    titulo_txt = titulo.get_text(strip=True) if titulo else \"Sin título\"\n",
        "\n",
        "                    # 2. Extraer el Autor\n",
        "                    # Buscamos firmas comunes en periódicos (clases o textos)\n",
        "                    autor_tag = soup_nota.find(class_=\"autor\") or soup_nota.find(class_=\"writer\")\n",
        "                    autor_txt = autor_tag.get_text(strip=True) if autor_tag else \"Autor no detectado\"\n",
        "\n",
        "                    # 3. Extraer la Fecha\n",
        "                    fecha_tag = soup_nota.find(class_=\"fecha\") or soup_nota.find(class_=\"date\") or soup_nota.find('time')\n",
        "                    fecha_txt = fecha_tag.get_text(strip=True) if fecha_tag else \"Fecha no detectada\"\n",
        "\n",
        "                    # 4. Extraer el Cuerpo del texto completo\n",
        "                    # Los periódicos suelen meter el texto de la nota dentro de un contenedor específico\n",
        "                    # Probamos con contenedores comunes de texto o recopilamos los párrafos <p> principales\n",
        "                    cuerpo_tag = soup_nota.find(class_=\"cuerpo-nota\") or soup_nota.find(class_=\"nota-txt\") or soup_nota.find('article')\n",
        "\n",
        "                    if cuerpo_tag:\n",
        "                        # Juntamos todos los párrafos dentro de ese contenedor\n",
        "                        parrafos = cuerpo_tag.find_all('p')\n",
        "                        texto_completo = \" \".join([p.get_text(strip=True) for p in parrafos])\n",
        "                    else:\n",
        "                        # Si no encuentra el contenedor, agarra todos los <p> que tengan una longitud decente\n",
        "                        parrafos = soup_nota.find_all('p')\n",
        "                        texto_completo = \" \".join([p.get_text(strip=True) for p in parrafos if len(p.get_text()) > 40])\n",
        "\n",
        "                    # Limpieza básica por si el texto quedó vacío\n",
        "                    if not texto_completo:\n",
        "                        texto_completo = \"No se pudo extraer el cuerpo del texto.\"\n",
        "\n",
        "                    # Guardamos la fila de datos\n",
        "                    datos_finales.append([titulo_txt, autor_txt, fecha_txt, texto_completo, url_nota])\n",
        "\n",
        "                else:\n",
        "                    print(f\"   -> Error al abrir esta nota (Código {res_nota.status_code})\")\n",
        "\n",
        "            except Exception as e:\n",
        "                print(f\"   -> Error procesando esta nota: {e}\")\n",
        "\n",
        "            # --- PAUSA CRÍTICA ---\n",
        "            # Esperamos 3 segundos antes de ir por la siguiente nota para que no nos bloqueen\n",
        "            time.sleep(3)\n",
        "\n",
        "        # Guardar todo en el CSV dentro de Colab\n",
        "        nombre_csv = \"editoriales_completas_siglo.csv\"\n",
        "        with open(nombre_csv, mode='w', newline='', encoding='utf-8-sig') as archivo:\n",
