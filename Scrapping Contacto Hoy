        "!pip install beautifulsoup4 requests\n",
        "import csv\n",
        "import os\n",
        "import time\n",
        "import requests\n",
        "from bs4 import BeautifulSoup\n",
        "from google.colab import files\n",
        "\n",
        "# --- CONFIGURACIÓN DE PÁGINAS ---\n",
        "# Cambia este número si quieres extraer más.\n",
        "# 1 página = ~20 notas. 3 páginas = ~60 notas, etc.\n",
        "PAGINAS_A_ESCRA_PEAR = 3\n",
        "\n",
        "headers = {\n",
        "    \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"\n",
        "}\n",
        "\n",
        "def escrapear_contacto_hoy_masivo():\n",
        "    enlaces_validos = set()\n",
        "\n",
        "    print(f\"Paso 1: Recolectando enlaces a lo largo de {PAGINAS_A_ESCRA_PEAR} páginas...\")\n",
        "\n",
        "    for pagina in range(1, PAGINAS_A_ESCRA_PEAR + 1):\n",
        "        # La primera página es la normal, las siguientes llevan /page/2/, /page/3/, etc.\n",
        "        if pagina == 1:\n",
        "            url_busqueda = \"https://contactohoy.com.mx/columnas/\"\n",
        "        else:\n",
        "            url_busqueda = f\"https://contactohoy.com.mx/columnas/page/{pagina}/\"\n",
        "\n",
        "        print(f\" -> Escaneando lista de notas en: Página {pagina}\")\n",
        "\n",
        "        try:\n",
        "            respuesta = requests.get(url_busqueda, headers=headers, timeout=10)\n",
        "            if respuesta.status_code == 404:\n",
        "                print(\" -> Llegamos al límite de páginas disponibles en el sitio.\")\n",
        "                break\n",
        "            elif respuesta.status_code != 200:\n",
        "                print(f\" -> Error al acceder a la página {pagina}: {respuesta.status_code}\")\n",
        "                continue\n",
        "\n",
        "            soup = BeautifulSoup(respuesta.text, 'html.parser')\n",
        "            articulos = soup.find_all('a', href=True)\n",
        "\n",
        "            for art in articulos:\n",
        "                href = art['href']\n",
        "                texto = art.get_text(strip=True)\n",
        "\n",
        "                if \"contactohoy.com.mx\" in href and len(texto) > 20:\n",
        "                    if not any(x in href for x in [\"/category/\", \"/tag/\", \"/author/\", \"/columnas/page/\"]):\n",
        "                        enlaces_validos.add(href)\n",
        "\n",
        "            # Breve pausa entre el escaneo de portadas\n",
        "            time.sleep(2)\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\" -> Error al escanear la página {pagina}: {e}\")\n",
        "\n",
        "    print(f\"\\nTotal de columnas únicas encontradas para procesar: {len(enlaces_validos)}\")\n",
        "\n",
        "    # Paso 2: Visitar cada enlace recolectado\n",
        "    datos_finales = []\n",
        "    conteo = 0\n",
        "\n",
        "    print(\"\\nPaso 2: Extrayendo contenido detallado de cada columna...\")\n",
        "    for url_nota in enlaces_validos:\n",
        "        conteo += 1\n",
        "        print(f\"[{conteo}/{len(enlaces_validos)}] Procesando: {url_nota}\")\n",
        "\n",
        "        try:\n",
        "            res_nota = requests.get(url_nota, headers=headers, timeout=10)\n",
        "            if res_nota.status_code == 200:\n",
        "                soup_nota = BeautifulSoup(res_nota.text, 'html.parser')\n",
        "\n",
        "                titulo = soup_nota.find('h1')\n",
        "                titulo_txt = titulo.get_text(strip=True) if titulo else \"Sin título\"\n",
        "\n",
        "                autor_tag = soup_nota.find(class_=\"author\") or soup_nota.find(class_=\"tdb-author-name\") or soup_nota.find(class_=\"entry-author-name\")\n",
        "                autor_txt = autor_tag.get_text(strip=True) if autor_tag else \"Autor no detectado\"\n",
        "\n",
        "                fecha_tag = soup_nota.find('time') or soup_nota.find(class_=\"entry-date\") or soup_nota.find(class_=\"tdb-entry-date\")\n",
        "                fecha_txt = fecha_tag.get_text(strip=True) if fecha_tag else \"Fecha no detectada\"\n",
        "\n",
        "                cuerpo_tag = soup_nota.find(class_=\"entry-content\") or soup_nota.find(class_=\"td-post-content\") or soup_nota.find('article')\n",
        "\n",
        "                if cuerpo_tag:\n",
        "                    parrafos = cuerpo_tag.find_all('p')\n",
        "                    texto_completo = \" \".join([p.get_text(strip=True) for p in parrafos])\n",
        "                else:\n",
        "                    parrafos = soup_nota.find_all('p')\n",
        "                    texto_completo = \" \".join([p.get_text(strip=True) for p in parrafos if len(p.get_text()) > 40])\n",
        "\n",
        "                if not texto_completo:\n",
        "                    texto_completo = \"No se pudo extraer el cuerpo del texto.\"\n",
        "\n",
        "                datos_finales.append([titulo_txt, autor_txt, fecha_txt, texto_completo, url_nota])\n",
        "\n",
        "            else:\n",
        "                print(f\"   -> Error al abrir (Código {res_nota.status_code})\")\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"   -> Error procesando nota: {e}\")\n",
        "\n",
        "        # Pausa de seguridad obligatoria\n",
        "        time.sleep(3)\n",
        "\n",
        "    # Guardar e iniciar descarga de resultados\n",
        "    nombre_csv = \"columnas_contacto_hoy_masivo.csv\"\n",
        "    with open(nombre_csv, mode='w', newline='', encoding='utf-8-sig') as archivo:\n",
        "        escritor = csv.writer(archivo)\n",
        "        escritor.writerow([\"Titulo\", \"Autor\", \"Fecha\", \"Texto Completo\", \"Enlace\"])\n",
        "        escritor.writerows(datos_finales)\n",
        "\n",
        "    print(f\"\\n¡Todo listo! Archivo '{nombre_csv}' generado con éxito.\")\n",
        "    print(f\"Se descargaron un total de {len(datos_finales)} columnas.\")\n",
        "    files.download(nombre_csv)\n",
        "\n",
        "# Ejecutar proceso masivo\n",
        "escrapear_contacto_hoy_masivo()"
      ]
